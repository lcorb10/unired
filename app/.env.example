# Copia este archivo como .env y pon tus datos de conexión.

# --- Neo4j Desktop (local) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=la-clave-de-tu-neo4j

# --- AuraDB Free (nube): reemplaza las 3 líneas de arriba por las del archivo
#     que descargas al crear la instancia, por ejemplo:
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=la-clave-que-te-da-aura

# Clave para los mensajes flash de Flask (cualquier texto)
FLASK_SECRET_KEY=cambia-esto

# --- UniRed ---
# Cuenta de administrador que crea cargar_datos.py
ADMIN_EMAIL=admin@unired.co
ADMIN_PASSWORD=pon-una-clave-segura
# Clave que reciben los usuarios de ejemplo (sebastian@mail.com, etc.)
CLAVE_DEMO=pon-una-clave-para-los-usuarios-de-ejemplo
# 1 = muestra datos de demostración
MODO_DEMO=1
